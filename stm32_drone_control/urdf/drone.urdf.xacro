<?xml version="1.0"?>
<robot name="stm32_drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Base Link (Robotun Kök Linki - Gazebo HIL Simülasyonu İçin Temiz Yapı) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- STL metre cinsindedir (0.52m x 0.52m) -->
        <mesh filename="package://stm32_drone_control/meshes/drone.stl" scale="1 1 1"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.25 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.52 0.52 0.11"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.025"/>
    </inertial>
  </link>

  <!-- IMU Sensor Link -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>

  <!-- Gazebo HIL Ayarları: Kinematik / Statik Mod (Fizik motoru pose komutlarını engellemez) -->
  <gazebo>
    <static>true</static>
  </gazebo>

  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.2 0.2 0.25 1</ambient>
        <diffuse>0.3 0.3 0.35 1</diffuse>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu/sim_data</topic>
    </sensor>
  </gazebo>

</robot>
