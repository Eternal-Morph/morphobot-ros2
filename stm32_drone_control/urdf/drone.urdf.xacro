<?xml version="1.0"?>
<robot name="stm32_drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Base Link (Robotun Kök Linki - Gazebo HIL Simülasyonu İçin Temiz Yapı) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- STL metre cinsindedir (0.52m x 0.52m) -->
        <mesh filename="package://stm32_drone_control/meshes/iris.stl" scale="1 1 1"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.25 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://stm32_drone_control/meshes/iris.stl" scale="1 1 1"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.025"/>
    </inertial>
  </link>

  <!-- Rotor 0 Linki (Tüm fiziksel özellikler ana URDF yapısında) -->
  <link name="rotor_0">
    <inertial>
      <!-- Kütle Merkezi -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="0.000273104" iyz="0" izz="0.000274004"/>
    </inertial>

    <visual>
      <!-- X veya Y ekseninde 90 derece döndürerek yere paralel hale getiriyoruz -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/> 
      <geometry>
        <mesh filename="package://stm32_drone_control/meshes/iris_prop_ccw.dae" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.005" radius="0.128"/>
      </geometry>
    </collision>
  </link>

  <!-- ===================================================================== -->
  <!--                               ROTOR 1                                 -->
  <!-- ===================================================================== -->
  <link name="rotor_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="0.000273104" iyz="0" izz="0.000274004"/>
    </inertial>
    
    <visual>
      <!-- Pervaneyi yere paralel hale getiren 90 derece (1.5708 radyan) rotasyon -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://stm32_drone_control/meshes/iris_prop_ccw.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.005" radius="0.128"/>
      </geometry>
    </collision>
  </link>

  <joint name="rotor_1_joint" type="revolute">
    <origin xyz="-0.13 0.2 0.023" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1e+16" upper="1e+16" effort="0" velocity="0"/>
  </joint>

  <!-- Gazebo Özel Renk Ataması -->
  <gazebo reference="rotor_1">
    <material>Gazebo/DarkGrey</material>
  </gazebo>


  <!-- ===================================================================== -->
  <!--                               ROTOR 2                                 -->
  <!-- ===================================================================== -->
  <link name="rotor_2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="0.000273104" iyz="0" izz="0.000274004"/>
    </inertial>
    
    <visual>
      <!-- Pervaneyi yere paralel hale getiren rotasyon -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://stm32_drone_control/meshes/iris_prop_cw.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.005" radius="0.128"/>
      </geometry>
    </collision>
  </link>

  <joint name="rotor_2_joint" type="revolute">
    <origin xyz="0.13 0.22 0.023" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1e+16" upper="1e+16" effort="0" velocity="0"/>
  </joint>

  <!-- Gazebo Özel Renk Ataması -->
  <gazebo reference="rotor_2">
    <material>Gazebo/Blue</material>
  </gazebo>


  <!-- ===================================================================== -->
  <!--                               ROTOR 3                                 -->
  <!-- ===================================================================== -->
  <link name="rotor_3">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="0.000273104" iyz="0" izz="0.000274004"/>
    </inertial>
    
    <visual>
      <!-- Pervaneyi yere paralel hale getiren rotasyon -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://stm32_drone_control/meshes/iris_prop_cw.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.005" radius="0.128"/>
      </geometry>
    </collision>
  </link>

  <joint name="rotor_3_joint" type="revolute">
    <origin xyz="-0.13 -0.2 0.023" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1e+16" upper="1e+16" effort="0" velocity="0"/>
  </joint>

  <!-- Gazebo Özel Renk Ataması -->
  <gazebo reference="rotor_3">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- Pervane Eklemi -->
  <joint name="rotor_0_joint" type="revolute">
    <origin xyz="0.13 -0.22 0.023" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_0"/>
    <axis xyz="0 0 1"/>
    <!-- Pervane olduğu için limitleri geniş tutuyoruz, dilersek type="continuous" da yapabiliriz -->
    <limit lower="-1e+16" upper="1e+16" effort="0" velocity="0"/>
  </joint>

  <!-- Sadece Gazebo'ya özel renk ataması -->
  <gazebo reference="rotor_0">
    <material>Gazebo/Blue</material>
  </gazebo>


  <!-- IMU Sensor Link -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>

  <!-- Gazebo HIL Ayarları: Kinematik / Statik Mod (Fizik motoru pose komutlarını engellemez) -->
  <gazebo>
    <static>true</static>
  </gazebo>

  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.2 0.2 0.25 1</ambient>
        <diffuse>0.3 0.3 0.35 1</diffuse>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu/sim_data</topic>
    </sensor>
  </gazebo>

</robot>
