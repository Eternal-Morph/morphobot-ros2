<?xml version="1.0" ?>
<robot name="eternalmorph" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo>
  <!-- Joint State Publisher Plugin -->
  <plugin
    filename="gz-sim-joint-state-publisher-system"
    name="gz::sim::systems::JointStatePublisher">
  </plugin>

  <!-- IMU System Plugin -->
  <plugin
    filename="gz-sim-imu-system"
    name="gz::sim::systems::Imu">
  </plugin>

  <!-- 3D Flight Odometry Publisher for Position Hold & Velocity Braking -->
  <plugin
    filename="gz-sim-odometry-publisher-system"
    name="gz::sim::systems::OdometryPublisher">
    <odom_frame>world</odom_frame>
    <robot_base_frame>base_link</robot_base_frame>
    <dimensions>3</dimensions>
    <odom_publish_frequency>50</odom_publish_frequency>
    <odom_topic>/odom</odom_topic>
  </plugin>

  <!-- Joint Position Controllers for Folding Mechanism -->
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sol_on_ground_mode</joint_name>
    <topic>/eternalmorph/sol_on_ground_mode/cmd_pos</topic>
    <p_gain>220.0</p_gain>
    <i_gain>0.5</i_gain>
    <d_gain>12.0</d_gain>
    <cmd_max>120.0</cmd_max>
    <cmd_min>-120.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sol_on_air_mode</joint_name>
    <topic>/eternalmorph/sol_on_air_mode/cmd_pos</topic>
    <p_gain>150.0</p_gain>
    <i_gain>0.1</i_gain>
    <d_gain>8.0</d_gain>
    <cmd_max>60.0</cmd_max>
    <cmd_min>-60.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sag_on_ground_mode</joint_name>
    <topic>/eternalmorph/sag_on_ground_mode/cmd_pos</topic>
    <p_gain>220.0</p_gain>
    <i_gain>0.5</i_gain>
    <d_gain>12.0</d_gain>
    <cmd_max>120.0</cmd_max>
    <cmd_min>-120.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sag_on_air_mode</joint_name>
    <topic>/eternalmorph/sag_on_air_mode/cmd_pos</topic>
    <p_gain>150.0</p_gain>
    <i_gain>0.1</i_gain>
    <d_gain>8.0</d_gain>
    <cmd_max>60.0</cmd_max>
    <cmd_min>-60.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sol_arka_ground_mode</joint_name>
    <topic>/eternalmorph/sol_arka_ground_mode/cmd_pos</topic>
    <p_gain>220.0</p_gain>
    <i_gain>0.5</i_gain>
    <d_gain>12.0</d_gain>
    <cmd_max>120.0</cmd_max>
    <cmd_min>-120.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sol_arka_air_mode</joint_name>
    <topic>/eternalmorph/sol_arka_air_mode/cmd_pos</topic>
    <p_gain>150.0</p_gain>
    <i_gain>0.1</i_gain>
    <d_gain>8.0</d_gain>
    <cmd_max>60.0</cmd_max>
    <cmd_min>-60.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sag_arka_ground_mode</joint_name>
    <topic>/eternalmorph/sag_arka_ground_mode/cmd_pos</topic>
    <p_gain>220.0</p_gain>
    <i_gain>0.5</i_gain>
    <d_gain>12.0</d_gain>
    <cmd_max>120.0</cmd_max>
    <cmd_min>-120.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sag_arka_air_mode</joint_name>
    <topic>/eternalmorph/sag_arka_air_mode/cmd_pos</topic>
    <p_gain>150.0</p_gain>
    <i_gain>0.1</i_gain>
    <d_gain>8.0</d_gain>
    <cmd_max>60.0</cmd_max>
    <cmd_min>-60.0</cmd_min>
  </plugin>

  <!-- Multicopter Motor Models for Propeller Control & Thrust -->
  <plugin filename="libgz-sim-multicopter-motor-model-system.so" name="gz::sim::systems::MulticopterMotorModel">
    <robotNamespace>eternalmorph</robotNamespace>
    <jointName>sol_on_pervane_joint</jointName>
    <linkName>sol_on_pervane_1</linkName>
    <turningDirection>ccw</turningDirection>
    <timeConstantUp>0.0125</timeConstantUp>
    <timeConstantDown>0.025</timeConstantDown>
    <maxRotVelocity>2000.0</maxRotVelocity>
    <motorConstant>2.0e-05</motorConstant>
    <momentConstant>0.04</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <actuator_number>0</actuator_number>
    <motorNumber>0</motorNumber>
    <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    <motorType>velocity</motorType>
  </plugin>

  <plugin filename="libgz-sim-multicopter-motor-model-system.so" name="gz::sim::systems::MulticopterMotorModel">
    <robotNamespace>eternalmorph</robotNamespace>
    <jointName>sol_arka_pervane_joint</jointName>
    <linkName>sol_arka_pervane_1</linkName>
    <turningDirection>cw</turningDirection>
    <timeConstantUp>0.0125</timeConstantUp>
    <timeConstantDown>0.025</timeConstantDown>
    <maxRotVelocity>2000.0</maxRotVelocity>
    <motorConstant>2.0e-05</motorConstant>
    <momentConstant>0.04</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <actuator_number>1</actuator_number>
    <motorNumber>1</motorNumber>
    <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    <motorType>velocity</motorType>
  </plugin>

  <plugin filename="libgz-sim-multicopter-motor-model-system.so" name="gz::sim::systems::MulticopterMotorModel">
    <robotNamespace>eternalmorph</robotNamespace>
    <jointName>sag_on_pervane_joint</jointName>
    <linkName>sag_on_pervane_1</linkName>
    <turningDirection>cw</turningDirection>
    <timeConstantUp>0.0125</timeConstantUp>
    <timeConstantDown>0.025</timeConstantDown>
    <maxRotVelocity>2000.0</maxRotVelocity>
    <motorConstant>2.0e-05</motorConstant>
    <momentConstant>0.04</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <actuator_number>2</actuator_number>
    <motorNumber>2</motorNumber>
    <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    <motorType>velocity</motorType>
  </plugin>

  <plugin filename="libgz-sim-multicopter-motor-model-system.so" name="gz::sim::systems::MulticopterMotorModel">
    <robotNamespace>eternalmorph</robotNamespace>
    <jointName>sag_arka_pervane_joint</jointName>
    <linkName>sag_arka_pervane_1</linkName>
    <turningDirection>ccw</turningDirection>
    <timeConstantUp>0.0125</timeConstantUp>
    <timeConstantDown>0.025</timeConstantDown>
    <maxRotVelocity>2000.0</maxRotVelocity>
    <motorConstant>2.0e-05</motorConstant>
    <momentConstant>0.04</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <actuator_number>3</actuator_number>
    <motorNumber>3</motorNumber>
    <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    <motorType>velocity</motorType>
  </plugin>
</gazebo>

<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="sol_on_ust_motor_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sag_on_ust_motor_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sol_arka_ust_motor_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sag_arka_ust_motor_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sol_on_tekerlek_eksen_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sol_on_tutucu_parca_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sag_on_tekerlek_eksen_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sag_on_tutucu_parca_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sol_arka_tekerlek_eksen_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sol_arka_tutucu_parca_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sag_arka_tekerlek_eksen_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sag_arka_tutucu_parca_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sol_on_teker_1">
  <material>${body_color}</material>
  <mu1>0.5</mu1>
  <mu2>0.15</mu2>
  <fdir1>0 1 0</fdir1>
  <kp>10000000.0</kp>
  <kd>1.0</kd>
  <minDepth>0.001</minDepth>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sol_arka_teker_1">
  <material>${body_color}</material>
  <mu1>0.5</mu1>
  <mu2>0.15</mu2>
  <fdir1>0 1 0</fdir1>
  <kp>10000000.0</kp>
  <kd>1.0</kd>
  <minDepth>0.001</minDepth>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sag_on_teker_1">
  <material>${body_color}</material>
  <mu1>0.5</mu1>
  <mu2>0.15</mu2>
  <fdir1>0 1 0</fdir1>
  <kp>10000000.0</kp>
  <kd>1.0</kd>
  <minDepth>0.001</minDepth>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sag_arka_teker_1">
  <material>${body_color}</material>
  <mu1>0.5</mu1>
  <mu2>0.15</mu2>
  <fdir1>0 1 0</fdir1>
  <kp>10000000.0</kp>
  <kd>1.0</kd>
  <minDepth>0.001</minDepth>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sol_on_pervane_1">
  <material>${body_color}</material>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sol_arka_pervane_1">
  <material>${body_color}</material>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sag_arka_pervane_1">
  <material>${body_color}</material>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="sag_on_pervane_1">
  <material>${body_color}</material>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="bacak_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <kp>100000.0</kp>
  <kd>1000.0</kd>
  <minDepth>0.00005</minDepth>
  <maxVel>0.0</maxVel>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="camera_1">
  <material>${body_color}</material>
  <sensor name="camera" type="camera">
    <pose>0 0.025 0.02 0 0 1.5707963</pose>
    <visualize>true</visualize>
    <update_rate>30.0</update_rate>
    <topic>/camera/image_raw</topic>
    <camera>
      <camera_info_topic>/camera/camera_info</camera_info_topic>
      <optical_frame_id>camera_1_optical_frame</optical_frame_id>
      <horizontal_fov>1.3962634</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.02</near>
        <far>300</far>
      </clip>
    </camera>
  </sensor>
</gazebo>

<gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>1</always_on>
    <update_rate>100</update_rate>
    <visualize>true</visualize>
    <topic>/imu/sim_data</topic>
  </sensor>
</gazebo>

</robot>
