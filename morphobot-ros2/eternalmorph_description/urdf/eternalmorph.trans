<?xml version="1.0" ?>
<robot name="eternalmorph" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="sol_on_ground_mode_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="sol_on_ground_mode">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="sol_on_ground_mode_actr">
