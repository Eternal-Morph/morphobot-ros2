<launch>

<rosparam file="$(find eternalmorph_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="eternalmorph" args="sol_on_ground_mode_position_controller sol_on_air_mode_position_controller sag_on_ground_mode_position_controller sag_on_air_mode_position_controller sol_arka_ground_mode_position_controller sol_arka_air_mode_position_controller sag_arka_ground_mode_position_controller sag_arka_air_mode_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/eternalmorph/joint_states"/>
</node>

</launch>