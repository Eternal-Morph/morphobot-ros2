<?xml version="1.0" ?>
<robot name="eternalmorph" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo>
  <!-- Joint State Publisher Plugin -->
  <plugin
    filename="gz-sim-joint-state-publisher-system"
    name="gz::sim::systems::JointStatePublisher">
  </plugin>

  <!-- Diff Drive / Skid Steer Control Plugin -->
  <plugin
    filename="gz-sim-diff-drive-system"
    name="gz::sim::systems::DiffDrive">
    <left_joint>sol_on_teker</left_joint>
    <left_joint>sol_arka_teker</left_joint>
    <right_joint>sag_on_teker</right_joint>
    <right_joint>sag_arka_teker</right_joint>
    <wheel_separation>0.4</wheel_separation>
    <wheel_radius>0.05</wheel_radius>
    <odom_publish_frequency>30</odom_publish_frequency>
    <topic>/cmd_vel</topic>
  </plugin>

  <!-- Joint Position Controllers for Folding Mechanism -->
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sol_on_ground_mode</joint_name>
    <topic>/eternalmorph/sol_on_ground_mode/cmd_pos</topic>
    <p_gain>150.0</p_gain>
    <i_gain>0.0</i_gain>
    <d_gain>10.0</d_gain>
    <cmd_max>50.0</cmd_max>
    <cmd_min>-50.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sol_on_air_mode</joint_name>
    <topic>/eternalmorph/sol_on_air_mode/cmd_pos</topic>
    <p_gain>150.0</p_gain>
    <i_gain>0.0</i_gain>
    <d_gain>10.0</d_gain>
    <cmd_max>50.0</cmd_max>
    <cmd_min>-50.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sag_on_ground_mode</joint_name>
    <topic>/eternalmorph/sag_on_ground_mode/cmd_pos</topic>
    <p_gain>150.0</p_gain>
    <i_gain>0.0</i_gain>
    <d_gain>10.0</d_gain>
    <cmd_max>50.0</cmd_max>
    <cmd_min>-50.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sag_on_air_mode</joint_name>
    <topic>/eternalmorph/sag_on_air_mode/cmd_pos</topic>
    <p_gain>150.0</p_gain>
    <i_gain>0.0</i_gain>
    <d_gain>10.0</d_gain>
    <cmd_max>50.0</cmd_max>
    <cmd_min>-50.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sol_arka_ground_mode</joint_name>
    <topic>/eternalmorph/sol_arka_ground_mode/cmd_pos</topic>
    <p_gain>150.0</p_gain>
    <i_gain>0.0</i_gain>
    <d_gain>10.0</d_gain>
    <cmd_max>50.0</cmd_max>
    <cmd_min>-50.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sol_arka_air_mode</joint_name>
    <topic>/eternalmorph/sol_arka_air_mode/cmd_pos</topic>
    <p_gain>150.0</p_gain>
    <i_gain>0.0</i_gain>
    <d_gain>10.0</d_gain>
    <cmd_max>50.0</cmd_max>
    <cmd_min>-50.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sag_arka_ground_mode</joint_name>
    <topic>/eternalmorph/sag_arka_ground_mode/cmd_pos</topic>
    <p_gain>150.0</p_gain>
    <i_gain>0.0</i_gain>
    <d_gain>10.0</d_gain>
    <cmd_max>50.0</cmd_max>
    <cmd_min>-50.0</cmd_min>
  </plugin>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sag_arka_air_mode</joint_name>
    <topic>/eternalmorph/sag_arka_air_mode/cmd_pos</topic>
    <p_gain>150.0</p_gain>
    <i_gain>0.0</i_gain>
    <d_gain>10.0</d_gain>
    <cmd_max>50.0</cmd_max>
    <cmd_min>-50.0</cmd_min>
  </plugin>
</gazebo>

<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
  <gravity>true</gravity>
</gazebo>

